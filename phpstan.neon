includes:
    - %currentWorkingDirectory%/vendor/magicsunday/coding-standard/phpstan/base.neon
    # Not part of the shared base: the Symfony extension is this application's own
    # addition, included explicitly because phpstan/extension-installer does not reach
    # Rector's bundled PHPStan.
    - %currentWorkingDirectory%/vendor/phpstan/phpstan-symfony/extension.neon
    - %currentWorkingDirectory%/vendor/phpstan/phpstan-symfony/rules.neon

parameters:
    # level: max, the rule packs (strict, deprecation, phpunit) and checked exceptions
    # come from the shared base.

    # Single-PHP application: 8.4 is both floor and ceiling.
    phpVersion: 80400

    tmpDir: %currentWorkingDirectory%/.build/cache/.phpstan.cache

    paths:
        - %currentWorkingDirectory%/src/
        - %currentWorkingDirectory%/tests/

    excludePaths:
        - %currentWorkingDirectory%/.build/
        - %currentWorkingDirectory%/tests/Fixtures/Extension/

    ignoreErrors:
        # The renderer writes the class name of this Rector rule into the rector.php files it
        # generates for other projects, so it names the class although Rector marks it as deprecated.
        -
            identifier: classConstant.deprecatedClass
            message: '#^Access to constant on deprecated class Rector\\Renaming\\Rector\\StaticCall\\RenameStaticMethodRector:#'
            path: %currentWorkingDirectory%/src/Generator/RectorConfigRenderer.php
            count: 1
